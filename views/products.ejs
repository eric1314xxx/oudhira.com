<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= isRTL ? 'rtl' : 'ltr' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t.nav.products %> | <%= t.meta.title %></title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .products { padding-top: 150px; min-height: 80vh; }
        .navbar { background: rgba(0,0,0,0.9) !important; }
        .products-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; margin-top: 50px; }
        .product-card { background: var(--black-medium); border: 1px solid rgba(212, 175, 55, 0.1); border-radius: 20px; padding: 40px; transition: var(--transition); position: relative; overflow: hidden; }
        .product-card:hover { transform: translateY(-10px); border-color: var(--gold); }
        .card-badge { position: absolute; top: 20px; right: 20px; background: var(--gold); color: var(--black); padding: 5px 15px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; }
        .product-name { font-size: 1.8rem; margin-bottom: 15px; color: var(--gold); }
        .product-desc { color: var(--gray); margin-bottom: 25px; font-size: 0.95rem; }
        .product-features { display: flex; gap: 20px; margin-bottom: 30px; color: var(--white); font-size: 0.9rem; }
        .product-features i { color: var(--gold); }
        .product-price { display: flex; align-items: baseline; gap: 5px; }
        .currency { font-size: 1rem; color: var(--gold); }
        .amount { font-size: 2rem; font-weight: 700; color: var(--white); }
    </style>
</head>
<body class="lang-<%= lang %>">
    <!-- Navigation -->
    <nav class="navbar" id="navbar">
        <div class="nav-container">
            <div class="logo">
                <a href="/">
                    <img src="/images/logo.png" alt="OUDHIRA LOGO" style="height: 50px;">
                </a>
            </div>
            <div class="nav-content-right">
                <div class="nav-links">
                    <a href="/" class="nav-link"><%= t.nav.home %></a>
                    <a href="/heritage" class="nav-link"><%= t.nav.heritage %></a>
                    <a href="/products" class="nav-link active"><%= t.nav.products %></a>
                    <a href="/experience" class="nav-link"><%= t.nav.experience %></a>
                    <a href="/#contact" class="nav-link"><%= t.nav.contact %></a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Products Section -->
    <section class="products" id="products">
        <div class="section-container">
            <div class="section-header centered">
                <span class="section-tag"><%= t.products.tag %></span>
                <h2 class="section-title"><%= t.products.title %></h2>
            </div>
            <div class="products-grid">
                <% t.products.items.forEach((product) => { %>
                <div class="product-card <%= product.featured ? 'featured' : '' %>">
                    <div class="card-badge"><%= product.badge %></div>
                    <div class="product-info">
                        <h3 class="product-name"><%= product.name %></h3>
                        <p class="product-desc"><%= product.description %></p>
                        <div class="product-features">
                            <span><i class="fas fa-wind"></i> <%= product.puffs %> <%= t.products.puffs %></span>
                            <span><i class="fas fa-battery-full"></i> <%= product.battery %></span>
                        </div>
                        <div class="product-price">
                            <span class="currency"><%= product.currency %></span>
                            <span class="amount"><%= product.price.toLocaleString() %></span>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-bottom">
            <div class="footer-container">
                <p class="copyright"><%= t.footer.copyright %></p>
            </div>
        </div>
    </footer>
    <script src="/js/main.js"></script>
</body>
</html>
