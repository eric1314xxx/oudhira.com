<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= isRTL ? 'rtl' : 'ltr' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t.nav.experience %> | <%= t.meta.title %></title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .experience { padding-top: 150px; min-height: 80vh; }
        .navbar { background: rgba(0,0,0,0.9) !important; }
        .experience-features { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 40px; margin-top: 60px; }
        .feature-item { text-align: center; padding: 40px; background: var(--black-medium); border-radius: 20px; transition: var(--transition); border: 1px solid rgba(212, 175, 55, 0.05); }
        .feature-item:hover { transform: translateY(-10px); border-color: var(--gold); }
        .feature-icon { font-size: 2.5rem; color: var(--gold); margin-bottom: 25px; }
        .feature-content h4 { font-size: 1.4rem; margin-bottom: 15px; color: var(--white); }
        .feature-content p { color: var(--gray); line-height: 1.6; }
    </style>
</head>
<body class="lang-<%= lang %>">
    <!-- Navigation -->
    <nav class="navbar" id="navbar">
        <div class="nav-container">
            <div class="logo">
                <a href="/">
                    <img src="/images/logo.png" alt="OUDHIRA LOGO" style="height: 50px;">
                </a>
            </div>
            <div class="nav-content-right">
                <div class="nav-links">
                    <a href="/" class="nav-link"><%= t.nav.home %></a>
                    <a href="/heritage" class="nav-link"><%= t.nav.heritage %></a>
                    <a href="/products" class="nav-link"><%= t.nav.products %></a>
                    <a href="/experience" class="nav-link active"><%= t.nav.experience %></a>
                    <a href="/#contact" class="nav-link"><%= t.nav.contact %></a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Experience Section -->
    <section class="experience" id="experience">
        <div class="section-container">
            <div class="experience-content">
                <div class="section-header">
                    <span class="section-tag"><%= t.experience.tag %></span>
                    <h2 class="section-title"><%= t.experience.title %></h2>
                </div>
                <div class="experience-features">
                    <% t.experience.features.forEach(feature => { %>
                    <div class="feature-item">
                        <div class="feature-icon"><i class="fas fa-<%= feature.icon %>"></i></div>
                        <div class="feature-content">
                            <h4><%= feature.title %></h4>
                            <p><%= feature.description %></p>
                        </div>
                    </div>
                    <% }); %>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-bottom">
            <div class="footer-container">
                <p class="copyright"><%= t.footer.copyright %></p>
            </div>
        </div>
    </footer>
    <script src="/js/main.js"></script>
</body>
</html>
